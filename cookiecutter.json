  "service_description": "Servicio <<=cookiecutter.service_name=>> del agentic-platform-lab",
  "package_name": "<<=cookiecutter.service_slug.replace('-', '_')=>>",
  "env_prefix": "<<=cookiecutter.package_name.upper() ~ '_'=>>",
